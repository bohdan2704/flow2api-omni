FROM python:3.11-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

COPY requirements.txt ./
RUN pip install --no-cache-dir --root-user-action=ignore -r requirements.txt

# The private config is supplied by a mandatory bind mount, not baked into the image.
COPY src/ ./src/
COPY scripts/ ./scripts/
COPY static/ ./static/
COPY main.py ./
COPY config/setting_example.toml ./config/setting.toml
RUN mkdir -p data tmp

EXPOSE 8000
CMD ["python", "main.py"]
